# Copy this file to server/.env (same folder) and fill in real values.
# server/.env is git-ignored. NEVER put real credentials in this example file.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas or local) ---
MONGO_URI=
# Optional. Database name used inside the cluster (default: taskflow)
MONGO_DB_NAME=taskflow

# --- Auth ---
# Use a long random string (24+ characters; required in production), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# Local development:  CORS_ORIGIN=http://localhost:5173
# Production (Render): CORS_ORIGIN=https://taskforageapp.netlify.app
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend; used for links inside emails (defaults to the first CORS origin).
CLIENT_URL=http://localhost:5173

# --- Email (Nodemailer) ---
# Gmail: use an App Password. Any other provider: set EMAIL_HOST / EMAIL_PORT / EMAIL_SECURE instead of EMAIL_SERVICE.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false

# --- Deadline reminders ---
REMINDER_INTERVAL_MINUTES=15
# Optional. Enables POST /api/internal/reminders (header x-cron-secret) for external schedulers.
CRON_SECRET=
